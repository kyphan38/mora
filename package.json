{
  "name": "mora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "rules": "node scripts/rules.mjs",
    "emu": "npm run rules -- --emu && firebase emulators:start --config firebase.emu.json --only auth,firestore,storage --project demo-mora",
    "dev:emu": "VITE_USE_EMULATORS=1 vite",
    "test:emu": "npm run rules -- --emu && VITE_USE_EMULATORS=1 firebase emulators:exec --config firebase.emu.json --only auth,firestore,storage --project demo-mora 'vitest run --config vitest.emu.config.ts'"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
