# Firebase web config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kyphan38-mora-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kyphan38-mora-app
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The only account that can sign in (client check)
VITE_ALLOWED_USER_EMAIL=
# Same email, used by scripts/rules.mjs for firestore.rules
ALLOWED_USER_EMAIL=
# 1 = use the local emulators (npm run emu) with the fake project demo-mora
VITE_USE_EMULATORS=
